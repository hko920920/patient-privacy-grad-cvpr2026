      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimizer",
        "learning_rate",
        "loss",
        "model_id",
        "class_weights"
      ],
      "properties": {
        "optimizer": {
          "const": "sgd"
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loss": {
          "const": "cross_entropy"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "class_weights": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_profile_id",
        "benchmark_profile_sha256",
        "dataset_id",
        "input_dim",
        "num_classes",
