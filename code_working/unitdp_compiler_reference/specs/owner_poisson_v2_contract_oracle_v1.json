        },
        "benchmark_profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "input_dim": {
          "type": "integer",
          "minimum": 1
        },
        "num_classes": {
          "type": "integer",
          "minimum": 2
        },
