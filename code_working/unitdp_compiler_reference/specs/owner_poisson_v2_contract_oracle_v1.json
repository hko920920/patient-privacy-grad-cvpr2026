{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unitdp.invalid/specs/owner_poisson_v2_contract_oracle_v1.json",
  "title": "Independent registered owner-Poisson V2 contract oracle",
  "description": "A declarative, implementation-independent acceptance specification for the strict V2 owner-Poisson route.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "execution",
    "privacy",
    "mechanism",
    "accountant",
    "contribution_policy",
    "optimization",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "unitdp.owner_poisson_contract.v2"
    },
    "route_id": {
      "const": "owa_owner_poisson_rdp_add_remove_v2"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "rng_backend",
        "implementation_id",
        "random_coins_public"
      ],
      "properties": {
        "profile": {
          "enum": [
            "research_benchmark",
            "privacy_release"
          ]
        },
        "rng_backend": {
          "enum": [
            "research_default",
            "system_csprng"
          ]
        },
        "implementation_id": {
          "const": "unitdp.owa_dpsgd.train_owner_poisson_fixed_v2"
        },
        "random_coins_public": {
          "const": false
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "adjacency",
        "target_epsilon",
        "delta"
      ],
      "properties": {
        "unit": {
          "const": "owner"
        },
        "adjacency": {
          "const": "add_remove_one_owner"
        },
        "target_epsilon": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "delta": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampler",
        "sampling_unit",
        "accounting_unit",
        "parameter_source",
        "owner_sample_rate",
        "total_steps",
        "clipping_unit",
        "noising_unit",
        "clip_norm",
        "noise_multiplier",
        "update_denominator",
        "empty_step_behavior",
        "per_owner_contribution",
        "owner_aggregation"
      ],
      "properties": {
        "sampler": {
          "const": "independent_bernoulli_owner"
        },
        "sampling_unit": {
          "const": "owner"
        },
        "accounting_unit": {
          "const": "owner"
        },
        "parameter_source": {
          "const": "registered_benchmark_profile"
        },
        "owner_sample_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "total_steps": {
          "type": "integer",
          "minimum": 1
        },
        "clipping_unit": {
          "const": "owner"
        },
        "noising_unit": {
          "const": "owner_sum"
        },
        "clip_norm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "noise_multiplier": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "update_denominator": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "empty_step_behavior": {
          "const": "apply_gaussian_update"
        },
        "per_owner_contribution": {
          "const": "one_clipped_vector"
        },
        "owner_aggregation": {
          "const": "mean"
        }
      }
    },
    "accountant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rdp_orders_id"
      ],
      "properties": {
        "id": {
          "const": "poisson_gaussian_rdp_add_remove_dual_v1"
        },
        "rdp_orders_id": {
          "const": "unitdp_integer_rdp_orders_v1"
        }
      }
    },
    "contribution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "max_windows_per_owner",
        "windows_per_owner_per_step",
        "scope"
      ],
      "properties": {
        "type": {
          "const": "support_balanced_cap"
        },
        "max_windows_per_owner": {
          "type": "integer",
          "minimum": 1
        },
        "windows_per_owner_per_step": {
          "type": "integer",
          "minimum": 1
        },
        "scope": {
          "const": "owner_local"
        }
      }
    },
