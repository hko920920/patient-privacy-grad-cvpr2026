          "$ref": "#/$defs/preprocessing_binding"
        },
        "public_protocol": {
          "$ref": "#/$defs/public_protocol"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution": {
            "properties": {
              "profile": {
                "const": "privacy_release"
              }
            },
            "required": [
              "profile"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "execution": {
            "properties": {
              "rng_backend": {
                "const": "system_csprng"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preprocessing_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "schema",
        "artifact_id",
        "artifact_sha256",
        "source_reference_sha256",
        "input_dim",
        "transform",
        "fit_on_protected_data"
